{
  "name": "Video Compression Data Extractor",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "video-webhook",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "4c4c4c4c-4c4c-4c4c-4c4c-4c4c4c4c4c4c",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "video-compression-hook"
    },
    {
      "parameters": {
        "jsCode": "// Extract video metadata and processing information\nconst inputData = $input.all();\nconst results = [];\n\nfor (const item of inputData) {\n  const body = item.json.body || item.json;\n  \n  // Extract video information\n  const extractedData = {\n    timestamp: new Date().toISOString(),\n    originalVideo: {\n      size_mb: body.original?.size || null,\n      filename: body.filename || 'unknown',\n      format: body.format || 'unknown'\n    },\n    optimizedVideo: {\n      size_mb: body.optimized?.size || null,\n      url: body.optimized?.url || null,\n      compression_ratio: null\n    },\n    processing: {\n      cloudinary_result: body.cloudinary_result || null,\n      transformation_applied: body.transformation || null,\n      processing_time: body.processing_time || null\n    }\n  };\n  \n  // Calculate compression ratio if both sizes available\n  if (extractedData.originalVideo.size_mb && extractedData.optimizedVideo.size_mb) {\n    const original = parseFloat(extractedData.originalVideo.size_mb);\n    const optimized = parseFloat(extractedData.optimizedVideo.size_mb);\n    extractedData.optimizedVideo.compression_ratio = ((original - optimized) / original * 100).toFixed(2) + '%';\n    extractedData.optimizedVideo.size_reduction = (original - optimized).toFixed(2) + ' MB';\n  }\n  \n  results.push({ json: extractedData });\n}\n\nreturn results;"
      },
      "id": "5d5d5d5d-5d5d-5d5d-5d5d-5d5d5d5d5d5d",
      "name": "Extract Video Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [460, 300]
    },
    {
      "parameters": {
